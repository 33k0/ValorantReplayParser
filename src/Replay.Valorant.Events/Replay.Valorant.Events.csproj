    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>ValorantReplayParser.Events</PackageId>
    <Description>High-level VALORANT gameplay events derived from native replay events.</Description>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\LibraryPackage.props" />
  <ItemGroup>
    <ProjectReference Include="..\Replay.Valorant\Replay.Valorant.csproj" />
